{
  "name": "site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run gen-api-docs && npm run sync-changelog && next build",
    "start": "next start",
    "sync-changelog": "node scripts/sync-changelog.mjs",
    "gen-api-docs": "typedoc --tsconfig ../tsconfig.typedoc.json --plugin typedoc-plugin-markdown --out content/docs/api --entryPointStrategy expand --entryPoints ../src/core/index.ts --entryPoints ../src/react/index.ts --skipErrorChecking --cleanOutputDir false && node scripts/inject-api-frontmatter.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@aliraslan/fx": "^0.1.0",
    "@tanstack/react-table": "^8.21.3",
    "fumadocs-core": "^16.15.11",
    "fumadocs-mdx": "^15.4.1",
    "fumadocs-ui": "^16.15.11",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^24.0.0",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  }
}
